# Example user unit for `terva-lampi agent`. Not installed by this tree.
# Copy to ~/.config/systemd/user/terva-lampi-agent.service
#
# Phase 0 places the lake on a small VPS. See docs/policy.md and
# docs/vps-bringup.md.
# This unit sets no server URL or token file. The agent reads
# --server, then LAMPI_SERVER, then server in config.json, then the
# loopback default, and the token file the same way. Put the VPS HTTPS
# URL in config.json or in ~/.config/terva-lampi/agent.env. Do not put
# a production hostname in this file, and do not publish plain HTTP.
#
# Harness enable and root live in ~/.config/terva-lampi/config.json.
# See deploy/config.json.example. Restart the user service
# after editing that file. A harness environment variable is a debug
# override. Precedence is flag (if any), then config root, then env,
# then the adapter default. SIGUSR1 syncs. It does not reload config.json.
#
#   systemctl --user daemon-reload
#   systemctl --user enable --now terva-lampi-agent.service
#
# SIGUSR1 asks the running agent to sync. The session directory watch
# is still the source of truth. ExecStart assumes the binary is at
# ~/.local/bin/terva-lampi. Change that path if you installed it elsewhere.

[Unit]
Description=terva-lampi capture agent
Documentation=https://github.com/terva-sh/lampi/blob/main/deploy/README.md

[Service]
Type=simple
EnvironmentFile=-%h/.config/terva-lampi/agent.env
ExecStart=%h/.local/bin/terva-lampi agent
Restart=on-failure

[Install]
WantedBy=default.target
