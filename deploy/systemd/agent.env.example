# Copy to ~/.config/terva-lampi/agent.env (mode 0600).
# The systemd user unit reads this file when it exists. Values here
# replace the unit's loopback defaults.
#
# The lake host is not decided yet (Phase 0). Leave LAMPI_SERVER unset,
# or set the loopback lake you are actually running. Do not invent a
# production host.

# LAMPI_SERVER=http://127.0.0.1:8787
# LAMPI_TOKEN_FILE=/home/you/.config/terva-lampi/token
