# Copy to .env beside compose.yaml. Do not commit the copy.

# A release of ghcr.io/terva-sh/lampi, such as 0.2.0. Read its release
# notes before changing this: a release can migrate the catalog.
LAMPI_VERSION=

# The name agents reach the lake at, without https://.
LAMPI_DOMAIN=lake.example.com

# An image built with `just image`. Podman names it localhost/terva-lampi.
#   LAMPI_IMAGE=terva-lampi
#   LAMPI_VERSION=dev
