<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  Example launchd agent for terva-lampi. Not installed by this tree.
  Copy to ~/Library/LaunchAgents/sh.terva.lampi.agent.plist.

  Phase 0 places the lake on a small VPS. See docs/policy.md and
  docs/vps-bringup.md.
  This plist passes no server URL or token file. The agent reads
  LAMPI_SERVER, then server in config.json, then the loopback default,
  and LAMPI_TOKEN_FILE, then token_file in config.json, then
  $HOME/.config/terva-lampi/token. Put the VPS HTTPS URL in config.json,
  or add LAMPI_SERVER under EnvironmentVariables. Do not invent a
  production hostname in this plist.

  The binary is $HOME/.local/bin/terva-lampi. The agent polls the
  harness trees on macOS. Add LAMPI_WATCH=fsnotify under
  EnvironmentVariables to use kqueue instead.
  SIGUSR1 asks the running agent to sync. The session directory watch
  is still the source of truth.

  Harness enable and root are $HOME/.config/terva-lampi/config.json.
  See deploy/config.json.example. Restart the agent after editing that
  file. A harness environment variable is a debug override. Precedence
  is flag (if any), then config root, then env, then the adapter
  default. SIGUSR1 does not reload config.json.
-->
<plist version="1.0">
<dict>
	<key>Label</key>
	<string>sh.terva.lampi.agent</string>
	<key>RunAtLoad</key>
	<true/>
	<key>KeepAlive</key>
	<true/>
	<key>ProgramArguments</key>
	<array>
		<string>/bin/sh</string>
		<string>-c</string>
		<string>exec "${HOME}/.local/bin/terva-lampi" agent</string>
	</array>
	<key>EnvironmentVariables</key>
	<dict>
	</dict>
</dict>
</plist>
