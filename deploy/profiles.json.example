{
  "profiles": {
    "default": {
      "agent": {"debounce": "5s", "debounce_max": "30s"},
      "projects": {
        "allow": [
          {"git_remote_prefix": "git@git.example:team"},
          {"git_remote": "git@git.example:other/app.git"}
        ],
        "deny": [{"cwd_prefix": "/home/you/private"}]
      }
    },
    "ci": {
      "harnesses": {"cursor": {"enabled": false}, "cursor-cli": {"enabled": false}},
      "projects": {
        "allow": [{"cwd_prefix": "/srv/ci/work"}]
      }
    }
  }
}
